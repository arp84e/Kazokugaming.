rules_version = '2';

// ============================================================
// REGLAS DE SEGURIDAD DE FIRESTORE - KAZOKUGAMING
// ============================================================
// Esto NO se sube a GitHub como parte del sitio: se publica desde
// la consola de Firebase (Firestore Database > Reglas) o con el
// Firebase CLI (`firebase deploy --only firestore:rules`).
//
// Principio general: por defecto TODO está denegado. Cada colección
// se abre explícitamente con el mínimo permiso necesario.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Lista de correos con permisos de administrador/moderación.
    // Se usa para: gestionar torneos y para poder eliminar cualquier
    // escuadrón o partida (moderación de contenido). Sustituye el correo
    // de ejemplo por el(los) tuyo(s) antes de publicar estas reglas, y
    // mantenlo IDÉNTICO a la constante CORREOS_ADMIN de admin.html.
    function esAdmin() {
      return request.auth != null &&
             request.auth.token.email in [
               'ajrojasp84e+1@gmail.com'
             ];
    }

    // ---------- PERFILES DE USUARIO ----------
    // usuarios/{uid}  { gamertag, email, creadoEn, ... }
    match /usuarios/{uid} {
      allow read: if true; // público: se muestra el gamertag en la comunidad
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['gamertag', 'email', 'creadoEn'])
                    && request.resource.data.gamertag is string
                    && request.resource.data.gamertag.size() > 0
                    && request.resource.data.gamertag.size() <= 30;
      allow update: if request.auth != null && request.auth.uid == uid &&
                    (!('gamertag' in request.resource.data) ||
                      (request.resource.data.gamertag is string &&
                       request.resource.data.gamertag.size() > 0 &&
                       request.resource.data.gamertag.size() <= 30)) &&
                    (!('bio' in request.resource.data) ||
                      (request.resource.data.bio is string &&
                       request.resource.data.bio.size() <= 200));
      allow delete: if false; // borrar cuenta se gestiona aparte, no vía cliente
    }

    // ---------- PARTIDAS RÁPIDAS (index.html) ----------
    // partidas/{id} { juego, nivel, mensaje, espacios, autorId, autorNombre, interesados: [uid,...], creadoEn }
    match /partidas/{partidaId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.autorId == request.auth.uid
                    && request.resource.data.mensaje is string
                    && request.resource.data.mensaje.size() <= 280
                    && request.resource.data.juego is string
                    && request.resource.data.espacios is int
                    && request.resource.data.espacios >= 1
                    && request.resource.data.espacios <= 10;
      // El autor puede editar cualquier campo de su propia partida.
      // Cualquier otro usuario autenticado SOLO puede tocar el campo
      // "interesados", y únicamente para agregarse a sí mismo (no puede
      // modificar el resto del documento ni añadir a otra persona).
      allow update: if request.auth != null && (
                    request.auth.uid == resource.data.autorId
                    ||
                    ( request.resource.data.diff(resource.data).affectedKeys().hasOnly(['interesados'])
                      && request.auth.uid in request.resource.data.interesados )
                    );
      allow delete: if request.auth != null
                    && (request.auth.uid == resource.data.autorId || esAdmin());

      // Chat de la partida: solo el autor y quienes están en "interesados"
      // (unirse es inmediato, sin aprobación, porque es algo casual).
      // partidas/{id}/mensajes/{id} { texto, autorId, autorNombre, creadoEn }
      match /mensajes/{mensajeId} {
        allow read: if request.auth != null &&
                    (request.auth.uid == get(/databases/$(database)/documents/partidas/$(partidaId)).data.autorId ||
                     request.auth.uid in get(/databases/$(database)/documents/partidas/$(partidaId)).data.interesados);
        allow create: if request.auth != null &&
                    (request.auth.uid == get(/databases/$(database)/documents/partidas/$(partidaId)).data.autorId ||
                     request.auth.uid in get(/databases/$(database)/documents/partidas/$(partidaId)).data.interesados) &&
                    request.resource.data.autorId == request.auth.uid &&
                    request.resource.data.texto is string &&
                    request.resource.data.texto.size() > 0 &&
                    request.resource.data.texto.size() <= 500;
        allow update: if false;
        allow delete: if request.auth != null &&
                    (request.auth.uid == resource.data.autorId || esAdmin());
      }
    }

    // ---------- ESCUADRONES (grupos.html) ----------
    // escuadrones/{id} { nombre, juego, descripcion, duenoId, miembros: [uids], capacidad }
    match /escuadrones/{escuadronId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.duenoId == request.auth.uid
                    && request.resource.data.nombre is string
                    && request.resource.data.nombre.size() <= 40
                    && request.resource.data.capacidad is int
                    && request.resource.data.capacidad <= 50;
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.duenoId;
      // el dueño puede borrar su escuadrón; un admin puede borrar cualquiera (moderación)
      allow delete: if request.auth != null
                    && (request.auth.uid == resource.data.duenoId || esAdmin());

      // Solicitudes de ingreso a un escuadrón concreto
      // escuadrones/{id}/solicitudes/{uid}
      match /solicitudes/{solicitanteUid} {
        // el propio solicitante puede crear/leer/borrar su solicitud;
        // el dueño del escuadrón puede leerlas todas para aprobarlas/rechazarlas
        allow create: if request.auth != null && request.auth.uid == solicitanteUid;
        allow read: if request.auth != null &&
                    (request.auth.uid == solicitanteUid ||
                     request.auth.uid == get(/databases/$(database)/documents/escuadrones/$(escuadronId)).data.duenoId);
        allow delete: if request.auth != null &&
                      (request.auth.uid == solicitanteUid ||
                       request.auth.uid == get(/databases/$(database)/documents/escuadrones/$(escuadronId)).data.duenoId);
        allow update: if false;
      }

      // Chat del escuadrón: solo pueden leer/escribir quienes ya son miembros
      // (el dueño acepta solicitudes agregando el uid al array "miembros" del
      // escuadrón; ese mismo array es lo que consulta esta regla).
      // escuadrones/{id}/mensajes/{id} { texto, autorId, autorNombre, creadoEn }
      match /mensajes/{mensajeId} {
        allow read: if request.auth != null &&
                    request.auth.uid in get(/databases/$(database)/documents/escuadrones/$(escuadronId)).data.miembros;
        allow create: if request.auth != null &&
                    request.auth.uid in get(/databases/$(database)/documents/escuadrones/$(escuadronId)).data.miembros &&
                    request.resource.data.autorId == request.auth.uid &&
                    request.resource.data.texto is string &&
                    request.resource.data.texto.size() > 0 &&
                    request.resource.data.texto.size() <= 500;
        allow update: if false;
        allow delete: if request.auth != null &&
                    (request.auth.uid == resource.data.autorId || esAdmin());
      }
    }

    // ---------- TORNEOS (torneos.html) ----------
    // torneos/{id} { titulo, juego, formato, fecha, recompensa, cupoMax, creadoPor, creadoEn }
    //
    // Reservado a administradores (ver esAdmin() al inicio del archivo).
    match /torneos/{torneoId} {
      allow read: if true;
      allow write: if esAdmin();

      // Inscripciones de un equipo o jugador a un torneo.
      // El conteo de inscritos NUNCA se guarda como número editable por el
      // cliente: se calcula contando los documentos de esta subcolección
      // (getCountFromServer), así nadie puede falsear el cupo desde la consola.
      match /inscripciones/{uid} {
        allow create: if request.auth != null && request.auth.uid == uid;
        allow read: if request.auth != null;
        allow delete: if request.auth != null && request.auth.uid == uid;
        allow update: if false;
      }
    }

    // ---------- RECORDATORIOS ("Avisarme" en torneos.html) ----------
    // recordatorios/{uid}_{eventoId} { uid, eventoId, creadoEn }
    match /recordatorios/{recordatorioId} {
      allow create: if request.auth != null &&
                    request.resource.data.uid == request.auth.uid &&
                    recordatorioId == (request.auth.uid + '_' + request.resource.data.eventoId);
      allow read, delete: if request.auth != null &&
                    resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // ---------- REPORTES (moderación de la comunidad) ----------
    // reportes/{id} { tipo: 'escuadron'|'partida'|'usuario', objetivoId,
    //                 objetivoNombre, motivo, reportadoPor, reportadoPorNombre,
    //                 estado: 'pendiente'|'revisado', creadoEn }
    // Cualquiera puede reportar; SOLO el admin puede leer/gestionar los reportes
    // (si cualquiera pudiera leerlos, se podría usar para acosar a quien reportó).
    match /reportes/{reporteId} {
      allow create: if request.auth != null
                    && request.resource.data.reportadoPor == request.auth.uid
                    && request.resource.data.tipo in ['escuadron', 'partida', 'usuario']
                    && request.resource.data.motivo is string
                    && request.resource.data.motivo.size() > 0
                    && request.resource.data.motivo.size() <= 300
                    && request.resource.data.estado == 'pendiente';
      allow read, update, delete: if esAdmin();
    }

    // Cualquier otra colección no listada queda bloqueada por defecto.
  }
}
