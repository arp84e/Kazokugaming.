rules_version = '2';

// ============================================================
// REGLAS DE SEGURIDAD DE FIRESTORE - KAZOKUGAMING
// ============================================================
// Esto NO se sube a GitHub como parte del sitio: se publica desde
// la consola de Firebase (Firestore Database > Reglas) o con el
// Firebase CLI (`firebase deploy --only firestore:rules`).
//
// Principio general: por defecto TODO está denegado. Cada colección
// se abre explícitamente con el mínimo permiso necesario.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- PERFILES DE USUARIO ----------
    // usuarios/{uid}  { gamertag, email, creadoEn, ... }
    match /usuarios/{uid} {
      allow read: if true; // público: se muestra el gamertag en la comunidad
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['gamertag', 'email', 'creadoEn'])
                    && request.resource.data.gamertag is string
                    && request.resource.data.gamertag.size() > 0
                    && request.resource.data.gamertag.size() <= 30;
      allow update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false; // borrar cuenta se gestiona aparte, no vía cliente
    }

    // ---------- PARTIDAS RÁPIDAS (index.html) ----------
    // partidas/{id} { juego, nivel, mensaje, espacios, autorId, autorNombre, creadoEn }
    match /partidas/{partidaId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.autorId == request.auth.uid
                    && request.resource.data.mensaje is string
                    && request.resource.data.mensaje.size() <= 280
                    && request.resource.data.juego is string
                    && request.resource.data.espacios is int
                    && request.resource.data.espacios >= 1
                    && request.resource.data.espacios <= 10;
      // solo el autor puede borrar/editar su propia partida
      allow update, delete: if request.auth != null
                             && request.auth.uid == resource.data.autorId;
    }

    // ---------- ESCUADRONES (grupos.html) ----------
    // escuadrones/{id} { nombre, juego, descripcion, dueñoId, miembros: [uids], capacidad }
    match /escuadrones/{escuadronId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.dueñoId == request.auth.uid
                    && request.resource.data.nombre is string
                    && request.resource.data.nombre.size() <= 40
                    && request.resource.data.capacidad is int
                    && request.resource.data.capacidad <= 50;
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.dueñoId;
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.dueñoId;

      // Solicitudes de ingreso a un escuadrón concreto
      // escuadrones/{id}/solicitudes/{uid}
      match /solicitudes/{solicitanteUid} {
        // el propio solicitante puede crear/leer/borrar su solicitud;
        // el dueño del escuadrón puede leerlas todas para aprobarlas/rechazarlas
        allow create: if request.auth != null && request.auth.uid == solicitanteUid;
        allow read: if request.auth != null &&
                    (request.auth.uid == solicitanteUid ||
                     request.auth.uid == get(/databases/$(database)/documents/escuadrones/$(escuadronId)).data.dueñoId);
        allow delete: if request.auth != null &&
                      (request.auth.uid == solicitanteUid ||
                       request.auth.uid == get(/databases/$(database)/documents/escuadrones/$(escuadronId)).data.dueñoId);
        allow update: if false;
      }
    }

    // ---------- TORNEOS (torneos.html) ----------
    // torneos/{id} { titulo, juego, formato, fecha, recompensa, cupoMax, creadoPor, creadoEn }
    //
    // Reservado a administradores. En vez de custom claims (que exigen el
    // Admin SDK / Cloud Functions, difíciles de gestionar solo con GitHub
    // Pages), usamos una lista de correos autorizados. Sustituye el correo
    // de ejemplo por el(los) tuyo(s) antes de publicar estas reglas.
    function esAdmin() {
      return request.auth != null &&
             request.auth.token.email in [
               'tu-correo-admin@ejemplo.com'
             ];
    }

    match /torneos/{torneoId} {
      allow read: if true;
      allow write: if esAdmin();

      // Inscripciones de un equipo o jugador a un torneo.
      // El conteo de inscritos NUNCA se guarda como número editable por el
      // cliente: se calcula contando los documentos de esta subcolección
      // (getCountFromServer), así nadie puede falsear el cupo desde la consola.
      match /inscripciones/{uid} {
        allow create: if request.auth != null && request.auth.uid == uid;
        allow read: if request.auth != null;
        allow delete: if request.auth != null && request.auth.uid == uid;
        allow update: if false;
      }
    }

    // ---------- RECORDATORIOS ("Avisarme" en torneos.html) ----------
    // recordatorios/{uid}_{eventoId} { uid, eventoId, creadoEn }
    match /recordatorios/{recordatorioId} {
      allow create: if request.auth != null &&
                    request.resource.data.uid == request.auth.uid &&
                    recordatorioId == (request.auth.uid + '_' + request.resource.data.eventoId);
      allow read, delete: if request.auth != null &&
                    resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // Cualquier otra colección no listada queda bloqueada por defecto.
  }
}
